AGENT_ZERO_ENVIRONMENT=local
AGENT_ZERO_DATA_DIR=./data
# Empty: SQLite files in AGENT_ZERO_DATA_DIR. `make up` always uses the compose Postgres.
AGENT_ZERO_DATABASE_URL=
POSTGRES_PASSWORD=reemplazar-por-una-clave-local
AGENT_ZERO_OPERATOR_SECRET=reemplazar-por-un-secreto-largo
AGENT_ZERO_GUARD_API_KEY=reemplazar-por-otra-clave-larga-para-los-agentes
AGENT_ZERO_LLM_MODE=demo
AGENT_ZERO_LLM_API_KEY=
AGENT_ZERO_LLM_MODEL=claude-haiku-5-5
AGENT_ZERO_LLM_DAILY_CALL_LIMIT=5000
AGENT_ZERO_LLM_SESSION_CALL_LIMIT=40
AGENT_ZERO_LLM_CAMPAIGN_CALL_LIMIT=1200
AGENT_ZERO_LLM_CAMPAIGN_TOKEN_LIMIT=1500000
AGENT_ZERO_LLM_DAILY_USD_LIMIT=2.0
AGENT_ZERO_CORS_ORIGINS=[]
AGENT_ZERO_ARENA_SESSION_LIMIT=100
